# Copy to .env and fill in two different, strong LOCAL-ONLY passwords.
# No Azure credentials or connection strings belong here.
COMPOSE_PROJECT_NAME=rachunki-local
LOCAL_SQL_ADMIN_PASSWORD=
LOCAL_SQL_APP_PASSWORD=
LOCAL_SQL_PORT=1433

APP_ENV=local
DB_HOST=127.0.0.1
DB_NAME=rachunki_dev
DB_USER=rachunki_app
